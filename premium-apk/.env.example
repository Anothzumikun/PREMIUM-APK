# Supabase — ambil dari Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key HANYA dipakai di server (misal upload admin lewat server action).
# JANGAN pernah taruh ini di kode yang jalan di browser / NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nama website (dipakai untuk metadata default sebelum data settings dimuat)
NEXT_PUBLIC_SITE_NAME="PREMIUM APK"
NEXT_PUBLIC_SITE_URL=https://premium-apk.vercel.app
